#!/usr/bin/env bash
# Apex Protocol — pre-commit hook
# 1. Pipeline stage gate: blocks commit if session is not in Ship stage.
# 2. Auto-curates memory from recent activity before each commit.

set -euo pipefail

REPO_ROOT="$(git rev-parse --show-toplevel 2>/dev/null || pwd)"

# ── Pipeline Stage Gate (push-based enforcement) ──────────────────────
# Blocks commit if the most recent apex session is NOT in Ship stage.
# Does NOT depend on APEX_SESSION_ID — finds state by most-recent mtime.
# Manual commits in non-apex projects are not blocked (.apex/ must exist).

APEX_DIR="${REPO_ROOT}/.apex"

if [ -d "$APEX_DIR" ]; then
  # Find the newest per-session state file
  NEWEST_STATE=""
  NEWEST_MTIME=0
  for f in "$APEX_DIR"/state.*.json; do
    [ -f "$f" ] || continue
    MTIME=$(stat -f '%m' "$f" 2>/dev/null || stat -c '%Y' "$f" 2>/dev/null || echo 0)
    if [ "$MTIME" -gt "$NEWEST_MTIME" ] 2>/dev/null; then
      NEWEST_MTIME="$MTIME"
      NEWEST_STATE="$f"
    fi
  done

  # Fall back to global state.json
  [ -z "$NEWEST_STATE" ] && [ -f "$APEX_DIR/state.json" ] && NEWEST_STATE="$APEX_DIR/state.json"

  if [ -n "$NEWEST_STATE" ]; then
    STAGE=$(python3 -c "
import json, sys
try:
    with open(sys.argv[1]) as f:
        print(json.load(f).get('current_stage', 'unknown'))
except Exception:
    print('unknown')
" "$NEWEST_STATE" 2>/dev/null || echo "unknown")

    # idle or unknown → no active pipeline → allow commit
    if [ "$STAGE" != "idle" ] && [ "$STAGE" != "unknown" ] && [ "$STAGE" != "ship" ]; then
      echo ""
      echo "════════════════════════════════════════════════════════"
      echo "  COMMIT BLOCKED — session stage is '${STAGE}', not 'ship'"
      echo "════════════════════════════════════════════════════════"
      echo ""
      echo "  Code changes must go through the full pipeline:"
      echo "  Execute → Review → Ship → Compound"
      echo ""
      echo "  If this is an ad-hoc fix from investigation/debugging,"
      echo "  enter the pipeline first:"
      echo "    apex stage set execute"
      echo "    (verify) → apex stage complete execute"
      echo "    (review) → apex stage set review → apex stage complete review"
      echo "    (ship)   → apex stage set ship"
      echo "    Then commit will succeed."
      echo ""
      exit 1
    fi
  fi
  # No state files at all → allow commit (apex init not yet run)
fi

# ── Memory Curation ──────────────────────────────────────────────────
APEX_BIN=""
if [ -x "$REPO_ROOT/dist/apex" ]; then
  APEX_BIN="$REPO_ROOT/dist/apex"
elif command -v apex >/dev/null 2>&1; then
  APEX_BIN="apex"
fi

if [ -z "$APEX_BIN" ]; then
  exit 0
fi

"$APEX_BIN" memory curate 2>/dev/null || true
"$APEX_BIN" telemetry end success 2>/dev/null || true

exit 0
